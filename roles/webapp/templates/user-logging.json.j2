{
  "appenders": {
    "files" : {
      "type": "dateFile",
      "filename": "{{service_log_directory}}/turalt-user.log",
      "pattern": "-yyyy-MM-dd",
      "alwaysIncludePattern": true,
      "compress": true
    }
  },
  "categories": {
    "default": {
      "appenders": [
        "files"
      ], 
      "level": "debug"
    }
  }
}
